#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
WHISPER_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BIN="$SCRIPT_DIR/whisper-cli"
MODEL="${WHISPER_MODEL:-$WHISPER_ROOT/models/ggml-base.en.bin}"

[[ -x "$BIN"   ]] || { echo "whisper-cli not found at $BIN" >&2; exit 1; }
[[ -f "$MODEL" ]] || { echo "model not found at $MODEL" >&2; exit 1; }

WAV="$(mktemp -p $HOME/_ramblings --suffix=.wav)"
PREFIX="${WAV%.wav}"
TXT="$PREFIX.txt"

echo "Recording to $WAV -- press Ctrl+C to stop & transcribe" >&2
trap : INT
arecord -q -f S16_LE -r 16000 -c 1 "$WAV" || true
trap - INT

echo "Transcribing..." >&2
"$BIN" -m "$MODEL" -f "$WAV" -otxt -of "$PREFIX" -np >/dev/null

echo "wrote $TXT" >&2
cat "$TXT"
